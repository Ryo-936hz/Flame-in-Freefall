{
  "name": "flamelab-si",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "packageManager": "npm@11.6.2",
  "workspaces": ["apps/web"],
  "scripts": {
    "generate:types": "node scripts/generate-types.mjs",
    "check:types": "node scripts/generate-types.mjs --check",
    "typecheck": "tsc --project apps/web/tsconfig.json",
    "test:client": "tsx --test apps/web/tests/client.test.ts apps/web/tests/mission-lab.test.ts apps/web/tests/mission-lab-state.test.ts apps/web/tests/mission-lab-panel.test.ts apps/web/tests/report.test.ts",
    "test:client:live": "tsx apps/web/tests/live-smoke.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "dev:web": "vite --config apps/web/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
