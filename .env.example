# Native API defaults to demo. Docker Compose defaults to local Qwen.
# FLAMELAB_AI_PROVIDER=demo
# For native Qwen, set FLAMELAB_AI_PROVIDER=qwen and run Ollama with the model below.
# FLAMELAB_OLLAMA_BASE_URL=http://127.0.0.1:11434
# FLAMELAB_OLLAMA_MODEL=qwen3:0.6b
FLAMELAB_SEED_DEMO=true
# FLAMELAB_DATABASE_URL=sqlite:///work/flamelab.db
# External synthesis is opt-in. Set both only in the server environment, never VITE_*.
# FLAMELAB_OPENAI_MODEL=
# FLAMELAB_OPENAI_API_KEY=
FLAMELAB_AI_TIMEOUT_SECONDS=30
# FLAMELAB_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
